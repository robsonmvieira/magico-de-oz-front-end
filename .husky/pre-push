echo "🧪 Running unit tests before push..."
npx vitest run

if [ $? -ne 0 ]; then
  echo "❌ Unit tests failed. Push aborted."
  exit 1
fi

echo "🎭 Running E2E tests before push..."
npx playwright test

if [ $? -ne 0 ]; then
  echo "❌ E2E tests failed. Push aborted."
  exit 1
fi

echo "✅ All tests passed!"
